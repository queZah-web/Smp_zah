{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lux:spark",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/lux_star"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "v.radius",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life * (0.7 + Math.random(0,0.6))"
      },
      "minecraft:particle_initial_speed": "v.speed * (0.5 + Math.random(0,1.0))",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.9,
          0
        ],
        "linear_drag_coefficient": 2.2
      },
      "minecraft:particle_initial_spin": {
        "rotation": "Math.random(0,360)",
        "rotation_rate": "Math.random(-90,90)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.size*(1-Math.pow(v.particle_age/v.particle_lifetime,2))*(0.75+0.25*Math.sin(v.particle_age*40))",
          "v.size*(1-Math.pow(v.particle_age/v.particle_lifetime,2))*(0.75+0.25*Math.sin(v.particle_age*40))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.r",
          "v.g",
          "v.b",
          "1.0 - Math.pow(v.particle_age/v.particle_lifetime,3)"
        ]
      }
    }
  }
}