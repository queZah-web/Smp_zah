{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "smp:farm_bit",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/smp_farm_bits"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life * (0.8 + v.particle_random_3 * 0.4)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(v.ring * (0.75 + v.particle_random_2 * 0.5)) * Math.cos(v.particle_random_1 * 360 + v.spin * v.particle_age)",
          "v.h0 + v.rise * (v.particle_age / v.particle_lifetime) * (0.6 + v.particle_random_4 * 0.8)",
          "(v.ring * (0.75 + v.particle_random_2 * 0.5)) * Math.sin(v.particle_random_1 * 360 + v.spin * v.particle_age)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.size * (0.8 + v.particle_random_4 * 0.5) * Math.min(1, v.particle_age * 6) * (1 - 0.4 * Math.pow(v.particle_age / v.particle_lifetime, 2))",
          "v.size * (0.8 + v.particle_random_4 * 0.5) * Math.min(1, v.particle_age * 6) * (1 - 0.4 * Math.pow(v.particle_age / v.particle_lifetime, 2))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 24,
          "texture_height": 8,
          "uv": [
            "v.tile * 8",
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.r + (v.r2 - v.r) * v.particle_random_4",
          "v.g + (v.g2 - v.g) * v.particle_random_4",
          "v.b + (v.b2 - v.b) * v.particle_random_4",
          "Math.min(1, v.particle_age * 8) * (1.0 - Math.pow(v.particle_age / v.particle_lifetime, 3.0))"
        ]
      }
    }
  }
}