{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "smp:dark_aura",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/lux_orb"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [
          "v.rx",
          "v.ry",
          "v.rz"
        ],
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life * (0.7 + Math.random(0,0.6))"
      },
      "minecraft:particle_initial_speed": "v.speed * (0.3 + Math.random(0,1.0))",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "v.rise",
          0
        ],
        "linear_drag_coefficient": 1.4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.size*(0.7+v.particle_random_1*0.9)*(0.6+0.9*(v.particle_age/v.particle_lifetime))",
          "v.size*(0.7+v.particle_random_1*0.9)*(0.6+0.9*(v.particle_age/v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.r",
          "v.g",
          "v.b",
          "0.85*Math.sin(Math.clamp(v.particle_age/v.particle_lifetime,0,1)*180)"
        ]
      }
    }
  }
}