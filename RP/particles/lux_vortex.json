          "(v.ring*(1-0.35*(Math.pow(v.particle_random_2,2.2)*v.hmax)/v.hmax)*(0.8+0.4*v.particle_random_3)*(1-v.shrink*Math.pow((v.particle_age/v.particle_lifetime),1.6)))*Math.cos((Math.floor(v.particle_random_1*3)*120+v.particle_random_4*30+v.spin*(v.tb+v.particle_age)+140*(Math.pow(v.particle_random_2,2.2)*v.hmax)))",
          "((Math.pow(v.particle_random_2,2.2)*v.hmax)+v.rise*(v.particle_age/v.particle_lifetime))",
          "(v.ring*(1-0.35*(Math.pow(v.particle_random_2,2.2)*v.hmax)/v.hmax)*(0.8+0.4*v.particle_random_3)*(1-v.shrink*Math.pow((v.particle_age/v.particle_lifetime),1.6)))*Math.sin((Math.floor(v.particle_random_1*3)*120+v.particle_random_4*30+v.spin*(v.tb+v.particle_age)+140*(Math.pow(v.particle_random_2,2.2)*v.hmax)))"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.size*(0.75+v.particle_random_4*0.6)*(1-0.5*Math.pow((v.particle_age/v.particle_lifetime),2))",
          "v.size*(0.75+v.particle_random_4*0.6)*(1-0.5*Math.pow((v.particle_age/v.particle_lifetime),2))"
