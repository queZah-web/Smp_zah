        "color": [
          "v.r",
          "v.g",
          "v.b",
          "v.alpha*1.0*Math.min(1,(v.particle_age/v.particle_lifetime)*8)*(1.0-Math.pow((v.particle_age/v.particle_lifetime),3.0))"
        ]
      }
    }
  }
