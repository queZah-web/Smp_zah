{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lux:pixel",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/lux_pixel"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [
          "v.half",
          "v.half",
          "v.half"
        ],
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life * (0.6 + Math.random(0,0.8))"
      },
      "minecraft:particle_initial_speed": "v.speed * (0.2 + Math.random(0,1.0))",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.18,
          0
        ],
        "linear_drag_coefficient": 1.8
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.size*(0.6+v.particle_random_1*1.0)*(1-Math.pow(v.particle_age/v.particle_lifetime,2))",
          "v.size*(0.6+v.particle_random_1*1.0)*(1-Math.pow(v.particle_age/v.particle_lifetime,2))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.r",
          "v.g",
          "v.b",
          "1.0 - Math.pow(v.particle_age/v.particle_lifetime,2.5)"
        ]
      }
    }
  }
}